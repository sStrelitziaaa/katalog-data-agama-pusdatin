# ==============================================================================
# KONFIGURASI DATABASE & KEAMANAN - SATU DATA AGAMA PUSDATIN KEMENAG RI
# Salin file ini menjadi ".env" atau ".env.local" untuk mengisi konfigurasi nyata.
# ==============================================================================

# 1. KONEKSI DATABASE POSTGRESQL
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?sslmode=[require|disable]
# 
# Contoh Koneksi Lokal (Docker / PostgreSQL Lokal):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kemenag_data_agama?sslmode=disable"
#
# Contoh Koneksi Cloud (Supabase / Neon / Google Cloud SQL):
# DATABASE_URL="postgresql://postgres.xxx:mypassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DATABASE_URL=""

# 2. KEAMANAN AKSES ADMINISTRATOR & API (CMS)
# Sandi / Kunci Rahasia untuk mengakses fitur unggah CMS di server backend
ADMIN_API_KEY="kemenag-pusdatin-secret-token-2025"

# 3. BATAS UKURAN FILE UNGGAH EXCEL (DALAM BYTE)
# Default: 10485760 (10 MB). Mencegah serangan DoS dari file berukuran raksasa
MAX_UPLOAD_FILE_SIZE=10485760

# 4. NEXT.js CACHE REVALIDATION (DETIK)
# Menentukan berapa lama data disimpan di cache publik sebelum mengecek ulang DB.
# Default: 3600 (1 jam). Membuat website sangat cepat dan tahan lonjakan jutaan pengunjung.
CACHE_REVALIDATE_SECONDS=3600
